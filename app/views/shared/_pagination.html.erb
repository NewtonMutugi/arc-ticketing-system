<% if pagy.pages > 1 %>
  <nav class="flex items-center justify-between px-4 py-3 sm:px-6 w-full" aria-label="Pagination">
    <div class="hidden sm:block">
      <p class="text-sm text-gray-700">
        Showing
        <span class="font-medium"><%= pagy.from %></span>
        to
        <span class="font-medium"><%= pagy.to %></span>
        of
        <span class="font-medium"><%= pagy.count %></span>
        results
      </p>
    </div>
    <div class="flex flex-1 justify-between sm:justify-end gap-2">
      <% if pagy.previous %>
        <%= link_to "Previous", url_for(request.parameters.merge(page: pagy.previous)), class: "relative inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus-visible:outline-offset-0 transition-colors" %>
      <% else %>
        <span class="relative inline-flex items-center rounded-md bg-gray-50 px-3 py-2 text-sm font-semibold text-gray-400 ring-1 ring-inset ring-gray-200 cursor-not-allowed">Previous</span>
      <% end %>

      <div class="hidden md:flex gap-1">
        <% pagy.send(:series).each do |item| %>
          <% if item.is_a?(Integer) %>
            <%= link_to item, url_for(request.parameters.merge(page: item)), class: "relative inline-flex items-center rounded-md px-3 py-2 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 transition-colors" %>
          <% elsif item.is_a?(String) && item.to_i > 0 %>
            <span class="relative z-10 inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm ring-1 ring-inset ring-indigo-600"><%= item %></span>
          <% else %>
            <span class="relative inline-flex items-center px-2 py-2 text-sm font-semibold text-gray-500">...</span>
          <% end %>
        <% end %>
      </div>

      <% if pagy.next %>
        <%= link_to "Next", url_for(request.parameters.merge(page: pagy.next)), class: "relative inline-flex items-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 ring-1 ring-inset ring-gray-300 hover:bg-gray-50 focus-visible:outline-offset-0 transition-colors" %>
      <% else %>
        <span class="relative inline-flex items-center rounded-md bg-gray-50 px-3 py-2 text-sm font-semibold text-gray-400 ring-1 ring-inset ring-gray-200 cursor-not-allowed">Next</span>
      <% end %>
    </div>
  </nav>
<% end %>
