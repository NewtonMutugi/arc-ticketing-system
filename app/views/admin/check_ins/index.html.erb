<% content_for :title, "Check-ins | #{@event.title}" %>

<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-6">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">Check-ins</h1>
    <p class="mt-1 text-sm text-gray-500">Manage daily check-ins for attendees.</p>
  </div>
  <div class="mt-4 sm:mt-0 flex gap-3">
    <%= form_with url: admin_event_check_ins_path(@event), method: :get, class: "relative", data: { turbo_frame: "attendees", turbo_action: "advance" } do |f| %>
      <%= f.hidden_field :date, value: @selected_date %>
      <i class="fa-solid fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
      <%= f.text_field :query, value: params[:query], placeholder: "Search name, email...", class: "pl-10 pr-4 py-2 border border-gray-300 rounded-lg text-sm focus:ring-indigo-500 focus:border-indigo-500" %>
    <% end %>
    <% if params[:query].present? %>
      <%= link_to "Clear", admin_event_check_ins_path(@event, date: @selected_date), class: "bg-white text-gray-700 border border-gray-300 px-4 py-2 rounded-lg text-sm font-medium hover:bg-gray-50" %>
    <% end %>
  </div>
</div>

<div class="mb-6 border-b border-gray-200">
  <nav class="-mb-px flex space-x-8 overflow-x-auto" aria-label="Tabs">
    <% @event_dates.each do |date| %>
      <%= link_to admin_event_check_ins_path(@event, date: date), class: class_names("whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm", @selected_date == date ? "border-indigo-500 text-indigo-600" : "border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300") do %>
        <%= date.strftime("%A, %b %d") %>
      <% end %>
    <% end %>
  </nav>
</div>

<%= turbo_frame_tag "attendees" do %>
  <div class="bg-white border border-gray-200 rounded-lg shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Attendee</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Ticket Type</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% if @attendees.empty? %>
            <tr>
              <td colspan="4" class="px-6 py-12 text-center text-gray-500">No attendees found.</td>
            </tr>
          <% else %>
            <% @attendees.each do |attendee| %>
              <% check_in = @check_ins_for_date[attendee.id] %>
              <tr class="hover:bg-gray-50 transition">
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="flex items-center">
                    <div class="h-10 w-10 flex-shrink-0">
                      <span class="h-10 w-10 rounded-full bg-indigo-100 flex items-center justify-center text-indigo-700 font-bold">
                        <%= attendee.first_name[0] %><%= attendee.last_name[0] %>
                      </span>
                    </div>
                    <div class="ml-4">
                      <div class="text-sm font-medium text-gray-900"><%= attendee.preferred_name.presence || "#{attendee.first_name} #{attendee.last_name}" %></div>
                      <div class="text-sm text-gray-500"><%= attendee.email %></div>
                    </div>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class="px-2 py-1 text-xs font-semibold rounded-full bg-blue-50 text-blue-700 border border-blue-100">
                    <%= attendee.ticket.title %>
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <% if check_in %>
                    <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-green-50 text-green-700 border border-green-200">
                      <i class="fa-solid fa-check mr-1.5"></i> Checked in at&nbsp;<span data-controller="local-time" data-local-time-datetime-value="<%= check_in.created_at.iso8601 %>" data-local-time-format-value="time"><%= check_in.created_at.strftime("%H:%M") %></span>
                    </span>
                  <% else %>
                    <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-600 border border-gray-200">
                      Not Checked In
                    </span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                  <% if check_in %>
                    <%= button_to "Undo", admin_event_check_in_path(@event, id: @selected_date, attendee_id: attendee.id), method: :delete, class: "text-red-600 hover:text-red-900 border border-transparent rounded-lg hover:bg-red-50 px-3 py-2 transition" %>
                  <% else %>
                    <%= button_to "Check In", admin_event_check_ins_path(@event, date: @selected_date, attendee_id: attendee.id), method: :post, class: "text-indigo-600 hover:text-indigo-900 border border-transparent rounded-lg hover:bg-indigo-50 px-3 py-2 transition" %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
    <% if @pagy.pages > 1 %>
      <div class="bg-gray-50 border-t border-gray-200">
        <%= render "shared/pagination", pagy: @pagy %>
      </div>
    <% end %>
  </div>
<% end %>
