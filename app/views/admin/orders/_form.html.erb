<%= form_with model: order, url: admin_event_orders_path(event), class: "w-full", data: { controller: "order-pricing" } do |f| %>
  <div class="modal-content bg-white rounded-lg shadow-xl overflow-hidden">
    <div class="modal-header flex justify-between items-center p-4 border-b border-gray-100">
      <h4 class="text-lg font-bold text-gray-800">
        <i class="fa fa-shopping-cart text-red-600 mr-2"></i>
        Create Manual Order
      </h4>
      <%= link_to admin_event_orders_path(event), class: "text-gray-400 hover:text-gray-600 transition-colors" do %>
        <i class="fa-solid fa-times text-xl"></i>
      <% end %>
    </div>
    
    <div class="modal-body p-6 max-h-[80vh] overflow-y-auto">
      <% if order.errors.any? %>
        <div class="mb-4 p-4 bg-red-50 text-red-700 rounded border border-red-200 text-sm">
          <ul class="list-disc ml-5">
            <% order.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
        <div class="col-span-1 md:col-span-2">
          <label for="order_ticket_id" class="relative block py-2 my-2">
            <select name="order[ticket_id]" id="order_ticket_id" required class="peer mt-0.5 w-full rounded border-gray-300 px-3 py-3 shadow-sm placeholder-transparent focus:border-red-600 focus:outline-none focus:ring-red-600 sm:text-sm" data-order-pricing-target="ticket" data-action="change->order-pricing#updatePrice">
              <option value="" disabled selected>Select a ticket</option>
              <% tickets.each do |t| %>
                <option value="<%= t.id %>" data-price="<%= t.price %>"><%= t.title %> - <%= number_to_currency(t.price, unit: 'KES ') %></option>
              <% end %>
            </select>
            <span class="pointer-events-none absolute start-3 top-0 -translate-y-1/2 bg-white px-0.5 text-xs text-gray-700 transition-all peer-placeholder-shown:top-1/2 peer-placeholder-shown:text-sm peer-focus:top-0 peer-focus:text-xs">Ticket</span>
          </label>
        </div>

        <div>
          <label for="order_quantity" class="relative block py-2 my-2">
            <input type="number" name="order[quantity]" id="order_quantity" value="1" min="1" required class="peer mt-0.5 w-full rounded border-gray-300 px-3 py-3 shadow-sm placeholder-transparent focus:border-red-600 focus:outline-none focus:ring-red-600 sm:text-sm" placeholder=" " data-order-pricing-target="quantity" data-action="input->order-pricing#updatePrice">
            <span class="pointer-events-none absolute start-3 top-0 -translate-y-1/2 bg-white px-0.5 text-xs text-gray-700 transition-all peer-placeholder-shown:top-1/2 peer-placeholder-shown:text-sm peer-focus:top-0 peer-focus:text-xs">Quantity</span>
          </label>
        </div>

        <div>
          <label for="order_total_cost" class="relative block py-2 my-2">
            <input type="number" step="0.01" name="order[total_cost]" id="order_total_cost" class="peer mt-0.5 w-full rounded border-gray-300 px-3 py-3 shadow-sm placeholder-transparent focus:border-red-600 focus:outline-none focus:ring-red-600 sm:text-sm" placeholder=" " data-order-pricing-target="total">
            <span class="pointer-events-none absolute start-3 top-0 -translate-y-1/2 bg-white px-0.5 text-xs text-gray-700 transition-all peer-placeholder-shown:top-1/2 peer-placeholder-shown:text-sm peer-focus:top-0 peer-focus:text-xs">Total Cost (Override)</span>
          </label>
          <p class="text-xs text-gray-500 mt-1">Leave blank to auto-calculate</p>
        </div>

        <div class="col-span-1 md:col-span-2 mt-4 border-t border-gray-100 pt-4">
          <h4 class="text-sm font-medium text-gray-700 mb-2">Buyer Details</h4>
        </div>

        <div class="col-span-1 md:col-span-2">
          <%= render InputComponent.new(
            label: "Buyer Name",
            name: "order[buyer_name]",
            value: order.buyer_name,
            placeholder: "e.g. John Doe",
            required: true
          ) %>
        </div>

        <div>
          <%= render InputComponent.new(
            label: "Buyer Email",
            name: "order[buyer_email]",
            type: "email",
            value: order.buyer_email,
            placeholder: "john@example.com",
            required: true
          ) %>
        </div>

        <div>
          <%= render InputComponent.new(
            label: "Buyer Phone",
            name: "order[buyer_phone_no]",
            value: order.buyer_phone_no,
            placeholder: "e.g. 0712345678",
            required: false
          ) %>
        </div>

        <div class="col-span-1 md:col-span-2 mt-2 border-t border-gray-100 pt-4">
          <h4 class="text-sm font-medium text-gray-700 mb-2">Order Status</h4>
        </div>

        <div>
          <%= render InputComponent.new(
            label: "Status",
            name: "order[status]",
            type: "select",
            value: order.status || 'paid',
            options: [['Paid (Approved)', 'paid'], ['Draft (Pending)', 'draft']]
          ) %>
        </div>

        <div>
          <%= render InputComponent.new(
            label: "Payment Provider",
            name: "order[payment_provider]",
            type: "select",
            value: order.payment_provider,
            options: [['M-Pesa', 'M-Pesa'], ['PayPal', 'PayPal']]
          ) %>
        </div>
      </div>
    </div>

    <div class="modal-footer p-4 border-t border-gray-100 bg-gray-50 flex justify-end gap-3">
      <%= link_to "Cancel", admin_event_orders_path(event), class: "px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded shadow-sm hover:bg-gray-50", data: { turbo_frame: "_top" } %>
      <%= f.submit "Create Order", class: "px-4 py-2 text-sm font-medium text-white bg-green-600 rounded shadow-sm hover:bg-green-700 cursor-pointer" %>
    </div>
  </div>
<% end %>
