<% content_for :title, "Orders | #{@event.title}" %>
<%= turbo_frame_tag "modal" %>
<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-6">
  <div>
    <h1 class="text-2xl font-bold text-gray-900">Orders</h1>
    <p class="mt-1 text-sm text-gray-500">View and manage customer orders.</p>
  </div>
  <div class="mt-4 sm:mt-0 flex flex-wrap gap-3 items-center">
    <%= form_with url: admin_event_orders_path(@event), method: :get, class: "relative", data: { turbo_frame: "orders", turbo_action: "advance" } do |f| %>
      <i class="fa-solid fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
      <%= f.text_field :query, value: params[:query], placeholder: "Search order no, name, email...", class: "pl-10 pr-4 py-2 border border-gray-300 rounded-lg text-sm focus:ring-indigo-500 focus:border-indigo-500" %>
    <% end %>
    <% if params[:query].present? %>
      <%= link_to "Clear", admin_event_orders_path(@event), class: "bg-white text-gray-700 border border-gray-300 px-4 py-2 rounded-lg text-sm font-medium hover:bg-gray-50" %>
    <% end %>
    <%= render ButtonComponent.new(type: "button", href: new_admin_event_order_path(@event), data: { turbo_frame: "modal" }) do %>
      <i class="fa-solid fa-plus"></i>
      Create Order
    <% end %>
  </div>
</div>

<%= turbo_frame_tag "orders" do %>
  <div class="bg-white border border-gray-200 rounded-lg shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Order No</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Customer</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Items</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Total</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody id="orders_list" class="bg-white divide-y divide-gray-200">
          <% if @orders.empty? %>
            <tr>
              <td colspan="7" class="px-6 py-12 text-center text-gray-500">No orders found.</td>
            </tr>
          <% else %>
            <%= render partial: "admin/orders/order_row", collection: @orders, as: :order, locals: { event: @event } %>
          <% end %>
        </tbody>
      </table>
    </div>
    <% if @pagy.pages > 1 %>
      <div class="bg-gray-50 border-t border-gray-200">
        <%= render "shared/pagination", pagy: @pagy %>
      </div>
    <% end %>
  </div>
<% end %>
