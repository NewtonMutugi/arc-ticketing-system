<div class="min-h-screen flex items-center justify-center bg-gray-100 p-4">
  <div class="bg-white p-8 rounded-lg shadow-xl max-w-md w-full">
    <div class="text-center mb-6">
      <h1 class="text-3xl font-bold text-gray-900"><%= @event.name %></h1>
      <p class="text-gray-500 mt-2">
        <%= @event.start_date.strftime("%b %d, %Y") %> - <%= @event.end_date.strftime("%b %d, %Y") %>
      </p>
      <p class="text-gray-500"><%= @event.location %></p>
    </div>

    <div class="rounded-lg bg-green-50 border border-green-200 p-4 mb-6 flex items-start">
      <svg class="w-6 h-6 text-green-600 mt-0.5 mr-3 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      <div>
        <h3 class="text-lg font-medium text-green-800">Valid Ticket</h3>
        <p class="text-green-700 text-sm mt-1">This ticket is authentic and issued by the event organizer.</p>
      </div>
    </div>

    <div class="border-t border-gray-200 pt-4 mb-6">
      <h3 class="text-sm font-semibold text-gray-900 uppercase tracking-wider mb-4">Attendee Details</h3>
      <dl class="grid grid-cols-1 gap-y-4">
        <div>
          <dt class="text-sm text-gray-500">Name</dt>
          <dd class="text-base font-medium text-gray-900"><%= @attendee.preferred_name.presence || "#{@attendee.first_name} #{@attendee.last_name}" %></dd>
        </div>
        <div>
          <dt class="text-sm text-gray-500">Ticket Type</dt>
          <dd class="text-base font-medium text-gray-900"><%= @attendee.ticket.title %></dd>
        </div>
        <div>
          <dt class="text-sm text-gray-500">Order Reference</dt>
          <dd class="text-base font-medium text-gray-900"><%= @attendee.order.order_no %></dd>
        </div>
      </dl>
    </div>

    <div class="bg-gray-50 -mx-8 -mb-8 p-6 rounded-b-lg border-t border-gray-200 text-center">
      <p class="text-sm text-gray-500">Please present this ticket to the event staff for check-in.</p>
    </div>
  </div>
</div>
