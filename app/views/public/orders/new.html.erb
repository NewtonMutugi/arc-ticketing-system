<% content_for :title, "Buy #{@ticket.title}" %>
<div class="max-w-3xl mx-auto">
  <div class="mb-6">
    <%= link_to event_path(@event), class: "text-gray-500 hover:text-gray-900 flex items-center gap-2 text-sm" do %>
      <i class="fa-solid fa-arrow-left"></i> Back to Event
    <% end %>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
    <div class="md:col-span-1">
      <div class="bg-gray-50 p-6 rounded-xl border border-gray-200 sticky top-4">
        <h3 class="text-sm font-bold text-gray-500 uppercase tracking-wider mb-2">Selected Ticket</h3>
        <h2 class="text-2xl font-bold text-gray-900 mb-2"><%= @ticket.title %></h2>
        <div class="text-xl font-bold text-red-600 mb-4" id="ticket-price-container" data-original-price="<%= @ticket.price %>">
          <span id="price-display"><%= @ticket.price == 0 ? "Free" : number_to_currency(@ticket.price, unit: "Ksh ", precision: 0) %></span>
          <span class="text-xs text-gray-500 font-normal">/ ticket</span>
        </div>
        <hr class="border-gray-200 my-4">
        <div class="text-sm text-gray-600">
          <p class="mb-1"><i class="fa-regular fa-calendar mr-2"></i> <%= @event.start_date.to_fs(:short) %></p>
          <p><i class="fa-solid fa-location-dot mr-2"></i> <%= @event.location %></p>
        </div>
        <hr class="border-gray-200 my-4">
        <div class="text-sm text-gray-600">
          <% if @ticket.benefits.present? %>
            <div class="mb-4">
              <h4 class="font-bold text-gray-700 text-sm mb-2">Includes:</h4>
              <ul class="space-y-2">
                <% @ticket.benefits.split("\n").each do |benefit| %>
                  <% next if benefit.blank? %>
                  <li class="flex items-start text-sm text-gray-600">
                    <i class="fa-solid fa-check text-green-500 mt-0.5 mr-2 flex-shrink-0"></i>
                    <span><%= benefit %></span>
                  </li>
                <% end %>
              </ul>
            </div>
            <hr class="border-gray-200 my-4">
          <% end %>
        </div>
      </div>
    </div>
    <div class="md:col-span-2">
      <div class="bg-white p-6 rounded-xl shadow-lg border border-gray-100">
        <h3 class="text-xl font-bold mb-6">Buyer Information</h3>
        <%= form_with url: event_orders_path(@event), method: :post, local: true do |f| %>
          <% if @order.persisted? %>
            <%= hidden_field_tag :order_no, @order.order_no %>
          <% end %>
          <div class="mb-8 bg-blue-50 p-4 rounded-lg border border-blue-100 flex justify-between items-center">
            <div>
              <label class="block font-bold text-gray-900">Quantity</label>
              <p class="text-xs text-gray-500">How many tickets?</p>
            </div>
            <div class="flex items-center w-32">
              <button type="button" onclick="adjustQty(-1)" class="w-10 h-10 rounded-l-lg bg-white border border-gray-300 flex items-center justify-center hover:bg-gray-50">-</button>
              <input type="number" id="ticket_qty" name="tickets[<%= @ticket.hashid %>]" value="<%= @order.persisted? ? (@order.order_items.find { |oi| oi.ticket_id == @ticket.id }&.quantity || 1) : 1 %>" min="1" max="10" class="w-full border-y border-gray-300 text-center h-10 focus:ring-0 z-10" readonly>
              <button type="button" onclick="adjustQty(1)" class="w-10 h-10 rounded-r-lg bg-white border border-gray-300 flex items-center justify-center hover:bg-gray-50">+</button>
            </div>
          </div>
          <div class="space-y-4">
            <%= render InputComponent.new(
              label: "Full Name",
              name: "buyer_name",
              id: "buyer_name",
              type: "text",
              placeholder: "Enter your full name",
              required: true,
              value: @order&.buyer_name,
            ) %>
            <%= render InputComponent.new(
              label: "Email Address",
              name: "buyer_email",
              id: "buyer_email",
              type: "email",
              placeholder: "We will send the receipt here",
              required: true,
              value: @order&.buyer_email,
            ) %>
            <%= render InputComponent.new(
              label: "Phone Number",
              name: "buyer_phone_no",
              id: "buyer_phone_no",
              type: "tel",
              placeholder: "For M-PESA payment",
              required: true,
              value: @order&.buyer_phone_no,
            ) %>
            
            <div class="mt-4 pt-4 border-t border-gray-100">
              <label class="block text-sm font-bold text-gray-900 mb-2">Discount Code (optional)</label>
              <div class="flex gap-2">
                <input type="text" name="discount_code" id="discount_code" class="w-full rounded-lg border-gray-300 shadow-sm focus:border-red-500 focus:ring-red-500 uppercase" placeholder="Enter code here" value="<%= @order&.discount_code&.code %>">
                <button type="button" onclick="applyDiscount()" class="bg-gray-800 text-white px-4 py-2 rounded-lg hover:bg-gray-700 font-bold text-sm whitespace-nowrap">Apply</button>
              </div>
              <p id="discount_message" class="text-xs mt-2 font-medium"></p>
            </div>
          </div>
          <div class="mt-8">
            <%= f.submit "Continue to Attendee Details",
                class: "w-full bg-red-600 text-white font-bold py-4 rounded-lg hover:bg-red-700 transition shadow-lg cursor-pointer flex justify-center items-center" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
<script>
  function adjustQty(amount) {
    const input = document.getElementById('ticket_qty');
    let newVal = parseInt(input.value) + amount;
    if (newVal >= 1 && newVal <= 10) {
      input.value = newVal;
    }
  }

  async function applyDiscount() {
    const codeInput = document.getElementById('discount_code');
    const msgEl = document.getElementById('discount_message');
    const priceDisplay = document.getElementById('price-display');
    const container = document.getElementById('ticket-price-container');
    const code = codeInput.value.trim();
    const originalPrice = parseFloat(container.dataset.originalPrice);

    if (!code) {
      msgEl.textContent = "Please enter a discount code.";
      msgEl.className = "text-xs mt-2 font-medium text-red-600";
      return;
    }

    msgEl.textContent = "Validating...";
    msgEl.className = "text-xs mt-2 font-medium text-gray-500";

    try {
      const response = await fetch(`/events/<%= @event.slug %>/discount_codes/validate?code=${encodeURIComponent(code)}&ticket_id=<%= @ticket.hashid %>`);
      const data = await response.json();

      if (data.valid) {
        msgEl.textContent = data.message;
        msgEl.className = "text-xs mt-2 font-medium text-green-600";
        
        let newPrice = originalPrice;
        if (data.discount_type === 'percentage') {
          newPrice = originalPrice - (originalPrice * (parseFloat(data.discount_amount) / 100));
        } else {
          newPrice = originalPrice - parseFloat(data.discount_amount);
        }
        
        if (newPrice < 0) newPrice = 0;
        
        const formattedOld = new Intl.NumberFormat('en-KE', { style: 'currency', currency: 'KES', maximumFractionDigits: 0 }).format(originalPrice).replace('KES', 'Ksh');
        const formattedNew = new Intl.NumberFormat('en-KE', { style: 'currency', currency: 'KES', maximumFractionDigits: 0 }).format(newPrice).replace('KES', 'Ksh');
        
        priceDisplay.innerHTML = `<span class="line-through text-gray-400 text-sm mr-2">${formattedOld}</span><span>${formattedNew}</span>`;
      } else {
        msgEl.textContent = data.error;
        msgEl.className = "text-xs mt-2 font-medium text-red-600";
        // Reset to original
        priceDisplay.textContent = originalPrice === 0 ? "Free" : new Intl.NumberFormat('en-KE', { style: 'currency', currency: 'KES', maximumFractionDigits: 0 }).format(originalPrice).replace('KES', 'Ksh');
      }
    } catch (error) {
      msgEl.textContent = "An error occurred while validating the code.";
      msgEl.className = "text-xs mt-2 font-medium text-red-600";
    }
  }
</script>
