<label for="<%= @id %>" class="<%= wrapper_classes %>" <%= "data-controller=\"password-visibility\"".html_safe if @type.to_s == "password" %>>
  <%# 1. HANDLE SELECT INPUTS %>
  <% if @type == "select" %>
    <select
      name="<%= @name %>"
      id="<%= @id %>"
      class="<%= input_classes %>"
      <%= "required" if @required %>
      autocomplete="<%= @autocomplete %>"
    >
      <option value="" disabled <%= "selected" if @value.nil? %>><%= @placeholder.strip.empty? ? "Select Option" : @placeholder %></option>
        <% if @options %>
          <% @options.each do |label, val| %>
            <option value="<%= val %>" <%= "selected" if val.to_s == @value.to_s %>><%= label %></option>
            <% end %>
          <% end %>
        </select>
        <%# 2. HANDLE TEXTAREA %>
      <% elsif @type == "textarea" %>
        <textarea
      name="<%= @name %>"
      id="<%= @id %>"
      rows="<%= @rows || 4 %>"
      class="<%= input_classes %>"
      placeholder="<%= @placeholder %>"
      <%= "required" if @required %>
      autocomplete="<%= @autocomplete %>"
    ><%= @value %></textarea>
        <%# 3. HANDLE REGULAR INPUTS (Text, Date, File, Password) %>
      <% else %>
        <input
      type="<%= @type %>"
      name="<%= @name %>"
      id="<%= @id %>"
      <%# File inputs cannot have a value attribute for security %>
      <%= "value=\"#{@value}\"".html_safe unless @type == "file" %>
      placeholder="<%= @placeholder %>"
      class="<%= input_classes %> <%= 'file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-red-50 file:text-red-700 hover:file:bg-red-100' if @type == 'file' %>"
      <%= "required" if @required %>
      autocomplete="<%= @autocomplete %>"
      <% if @accept %>accept="<%= @accept %>"<% end %>
      <%= "data-password-visibility-target=\"input\"".html_safe if @type.to_s == "password" %>
    >
        <% end %>
        <% if @type.to_s == "password" %>
          <button type="button" tabindex="-1" class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 focus:outline-none cursor-pointer" data-action="click->password-visibility#toggle">
            <svg data-password-visibility-target="open" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <svg data-password-visibility-target="closed" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 hidden">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 001.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.45 10.45 0 0112 4.5c4.756 0 8.773 3.162 10.065 7.498a10.523 10.523 0 01-4.293 5.774M6.228 6.228L3 3m3.228 3.228l3.65 3.65m7.894 7.894L21 21m-3.228-3.228l-3.65-3.65m0 0a3 3 0 10-4.243-4.243m4.242 4.242L9.88 9.88" />
            </svg>
          </button>
        <% end %>
        <%# LABEL RENDER (Standard vs Floating) %>
        <span class="<%= label_classes %>">
          <%= @label %>
        </span>
      </label>
