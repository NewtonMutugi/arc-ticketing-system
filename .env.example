# Database (Local Postgres)
POSTGRES_HOST=
POSTGRES_USER=
POSTGRES_PASSWORD=

# App Config
RAILS_MAX_THREADS=

# VPS IP Address
VPS_IP=

# KAMAL REGISTRY PASSWORD
KAMAL_REGISTRY_PASSWORD=

# RAILS MASTER KEY
RAILS_MASTER_KEY=

# MPESA CONFIG
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
# Only needed if your Till has a separate Store Number from the Till/Agent number
# (Daraja "Agent number and Store number entered do not match" otherwise).
# Falls back to MPESA_SHORTCODE if unset.
MPESA_TILL_NUMBER=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=http://localhost:3000/webhooks/mpesa

# PAYPAL CONFIG
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

